{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSHBool",
  "version": "0.1.8",
  "identifier": "com.sshbool.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SSHBool",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'"],
        "img-src": ["'self'", "data:", "asset:"],
        "font-src": ["'self'", "data:"],
        "connect-src": [
          "'self'",
          "ipc:",
          "asset:",
          "ws://127.0.0.1:*",
          "ws://localhost:*",
          "https://ssh.devbool.com",
          "https://github.com",
          "https://*.githubusercontent.com"
        ],
        "worker-src": ["'self'", "blob:"],
        "object-src": ["'none'"],
        "base-uri": ["'self'"],
        "frame-ancestors": ["'none'"]
      },
      "freezePrototype": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEREOTk0NUUyOUU5MjhBNUQKUldSZGlwS2U0a1daM2UxN2xxUkt1Q3p5Sm9uUTRvWnRIdmtSV29ESDUwNnJka05kOTZ0L3hrR1cK",
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://ssh.devbool.com/api/v1/update/{{target}}-{{arch}}/{{current_version}}?channel=stable"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": ["sshbool"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/wfreerdp"],
    "resources": {
      "binaries/guacd/README.md": "binaries/guacd/README.md",
      "../scripts/download-guacd.ps1": "scripts/download-guacd.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  }
}
